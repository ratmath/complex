{
  "name": "@ratmath/complex",
  "version": "0.1.0",
  "description": "Complex and hypercomplex numbers for RatMath: exact complex arithmetic, honest branches, certified complex analysis, quaternions and octonions",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./cayley": {
      "types": "./cayley.d.ts",
      "default": "./cayley.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cayley.js",
    "cayley.d.ts",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "bun test ./tests",
    "docs:build": "bun scripts/build-docs.js"
  },
  "keywords": [
    "complex",
    "quaternion",
    "octonion",
    "contour-integral",
    "residue",
    "exact",
    "ratmath"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ratmath/complex.git"
  },
  "homepage": "https://ratmath.com/complex/",
  "bugs": {
    "url": "https://github.com/ratmath/complex/issues"
  },
  "dependencies": {
    "@ratmath/analytic": "^0.1.0"
  },
  "peerDependencies": {
    "@ratmath/core": ">=0.10.0 <0.12.0"
  },
  "devDependencies": {
    "@ratmath/core": "^0.11.0",
    "katex": "0.19.1"
  },
  "types": "index.d.ts",
  "author": "James Taylor",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "vendor/analytic"
  ]
}
